-- ==============================================================================
-- Configuration
-- ==============================================================================

local POLL_INTERVAL_MS = 1000          -- how often game state is re-collected while in-game
local RATE_LIMIT_COOLDOWN_MS = 15000   -- Discord only accepts one SET_ACTIVITY roughly every 15s
local RECONNECT_RETRY_MS = 3000        -- gap between pipe reconnect attempts
local HANDSHAKE_TIMEOUT_MS = 3000      -- give up on a handshake that never gets a response
local DEFAULT_APP_ID = "1528189827089170582"

local LOG_TAG = "[AnomalyRPC]"

local last_update_time = 0
local has_dumped_placeholders = false
local last_known_debug_state = false

if not _G.anomaly_rpc_start_time then
    _G.anomaly_rpc_start_time = os.time()
end

-- ==============================================================================
-- Logging
-- ==============================================================================

local function write_custom_log(level, text)
    local timestamp = os.date("%H:%M:%S")
    printf("[%s] %s %s %s", timestamp, LOG_TAG, level, text)
end

local function is_debug_enabled()
    if ui_mcm then
        local v = ui_mcm.get("anomaly_rpc/debug_mode")
        if v ~= nil then return v end
    end
    return false
end

local function refresh_debug_state()
    last_known_debug_state = is_debug_enabled()
end

local function dbg(fmt, ...)
    if last_known_debug_state then
        write_custom_log("[DEBUG]", string.format(fmt, ...))
    end
end

local function log_error(fmt, ...)
    write_custom_log("[ERROR]", string.format(fmt, ...))
end

local function safe_call(label, default, fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then
        return result
    end
    log_error("Call to '%s' failed, falling back to default (%s): %s", label, tostring(default), tostring(result))
    return default
end

-- ==============================================================================
-- Discord IPC (LuaJIT FFI, no external DLL)
-- ==============================================================================

local FFI_OK, ffi = pcall(require, "ffi")
local k32, ffi_warned = nil, false

if FFI_OK then
    FFI_OK = pcall(ffi.cdef, [[
    typedef void* HANDLE;
    typedef unsigned long DWORD;
    typedef int BOOL;
    typedef unsigned long* LPDWORD;
    typedef void* LPVOID;
    typedef const void* LPCVOID;
    typedef const char* LPCSTR;

    HANDLE CreateFileA(LPCSTR lpFileName, DWORD dwDesiredAccess, DWORD dwShareMode,
                        void* lpSecurityAttributes, DWORD dwCreationDisposition,
                        DWORD dwFlagsAndAttributes, HANDLE hTemplateFile);
    BOOL WriteFile(HANDLE hFile, LPCVOID lpBuffer, DWORD nNumberOfBytesToWrite,
                   LPDWORD lpNumberOfBytesWritten, void* lpOverlapped);
    BOOL ReadFile(HANDLE hFile, LPVOID lpBuffer, DWORD nNumberOfBytesToRead,
                  LPDWORD lpNumberOfBytesRead, void* lpOverlapped);
    BOOL PeekNamedPipe(HANDLE hNamedPipe, LPVOID lpBuffer, DWORD nBufferSize,
                        LPDWORD lpBytesRead, LPDWORD lpTotalBytesAvail,
                        LPDWORD lpBytesLeftThisMessage);
    BOOL CloseHandle(HANDLE hObject);
    DWORD GetCurrentProcessId();
    ]])
    if FFI_OK then
        k32 = ffi.load("kernel32.dll")
    end
end

local GENERIC_READ_WRITE = 0xC0000000 -- GENERIC_READ | GENERIC_WRITE, bits never overlap so + works too
local OPEN_EXISTING = 3
local INVALID_HANDLE = FFI_OK and ffi.cast("void*", -1) or nil

-- connection_state: "disconnected" | "handshaking" | "ready"
local discord_pipe = nil
local connection_state = "disconnected"
local next_connect_attempt = 0
local handshake_deadline = 0
local last_send_time = -RATE_LIMIT_COOLDOWN_MS
local pending_payload = nil
local last_sent_payload = nil

local function get_app_id()
    local ini = ini_file("rpc_config.ltx")
    if not (ini and ini:section_exist("rpc_settings") and ini:line_exist("rpc_settings", "app_id")) then
        return DEFAULT_APP_ID
    end

    local raw = ini:r_string("rpc_settings", "app_id")
    if not raw then return DEFAULT_APP_ID end

    raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
    if raw:sub(1, 1) == "\"" and raw:sub(-1) == "\"" then
        raw = raw:sub(2, -2)
    end

    return raw ~= "" and raw or DEFAULT_APP_ID
end

local function le_u32(n)
    return string.char(n % 256, math.floor(n / 256) % 256,
                        math.floor(n / 65536) % 256, math.floor(n / 16777216) % 256)
end

local function send_frame(opcode, json_payload)
    local frame = le_u32(opcode) .. le_u32(#json_payload) .. json_payload
    local buf = ffi.new("char[?]", #frame, frame)
    local written = ffi.new("DWORD[1]")
    return k32.WriteFile(discord_pipe, buf, #frame, written, nil) ~= 0
end

local function read_frame_payload(buf, len)
    if len <= 8 then return "" end
    return ffi.string(buf + 8, len - 8)
end

local function close_discord_pipe(reason)
    if discord_pipe then
        k32.CloseHandle(discord_pipe)
        discord_pipe = nil
    end
    if connection_state ~= "disconnected" then
        dbg("Discord pipe closed (%s).", reason or "unknown")
    end
    connection_state = "disconnected"
end

local function try_connect_discord()
    for i = 0, 9 do
        local pipe_name = "\\\\.\\pipe\\discord-ipc-" .. i
        local handle = k32.CreateFileA(pipe_name, GENERIC_READ_WRITE, 0, nil, OPEN_EXISTING, 0, nil)
        if handle ~= INVALID_HANDLE then
            discord_pipe = handle
            dbg("Connected to %s.", pipe_name)

            local handshake = string.format('{"v":1,"client_id":"%s"}', get_app_id())
            if send_frame(0, handshake) then
                connection_state = "handshaking"
                handshake_deadline = time_global() + HANDSHAKE_TIMEOUT_MS
                dbg("Handshake sent, waiting for READY.")
            else
                log_error("Failed to write Discord handshake packet.")
                close_discord_pipe("handshake write failed")
            end
            return
        end
    end
    dbg("No discord-ipc-N pipe found; is Discord running?")
end

local function poll_handshake()
    local avail = ffi.new("DWORD[1]")
    if k32.PeekNamedPipe(discord_pipe, nil, 0, nil, avail, nil) == 0 then
        close_discord_pipe("pipe broke during handshake")
        return
    end

    if avail[0] > 0 then
        local buf = ffi.new("char[?]", avail[0])
        local read = ffi.new("DWORD[1]")
        if k32.ReadFile(discord_pipe, buf, avail[0], read, nil) == 0 then
            close_discord_pipe("read failed during handshake")
            return
        end
        local response = read_frame_payload(buf, read[0])
        if response:find("READY", 1, true) then
            dbg("Handshake response: %s", response)
        else
            log_error("Handshake did not return READY, Discord said: %s", response)
        end
        connection_state = "ready"
        return
    end

    if time_global() > handshake_deadline then
        log_error("Discord handshake timed out.")
        close_discord_pipe("handshake timeout")
    end
end

local function poll_ready()
    local avail = ffi.new("DWORD[1]")
    if k32.PeekNamedPipe(discord_pipe, nil, 0, nil, avail, nil) == 0 then
        close_discord_pipe("pipe broke")
        return
    end

    if avail[0] > 0 then
        local buf = ffi.new("char[?]", avail[0])
        local read = ffi.new("DWORD[1]")
        if k32.ReadFile(discord_pipe, buf, avail[0], read, nil) ~= 0 then
            dbg("Discord ack: %s", read_frame_payload(buf, read[0]))
        end
    end

    if not pending_payload then return end

    local now = time_global()
    if now - last_send_time < RATE_LIMIT_COOLDOWN_MS then return end

    local activity_frame = string.format(
        '{"cmd":"SET_ACTIVITY","args":{"pid":%d,"activity":%s},"nonce":"anomaly_rpc"}',
        tonumber(k32.GetCurrentProcessId()), pending_payload
    )

    if send_frame(1, activity_frame) then
        dbg("Presence sent to Discord.")
        last_sent_payload = pending_payload
        pending_payload = nil
        last_send_time = now
    else
        log_error("Failed to write SET_ACTIVITY packet.")
        close_discord_pipe("write failed")
    end
end

local function network_tick()
    if not FFI_OK then
        if not ffi_warned then
            log_error("LuaJIT FFI unavailable; Discord presence is disabled.")
            ffi_warned = true
        end
        return
    end

    if connection_state == "disconnected" then
        local now = time_global()
        if now >= next_connect_attempt then
            try_connect_discord()
            next_connect_attempt = now + RECONNECT_RETRY_MS
        end
    elseif connection_state == "handshaking" then
        poll_handshake()
    elseif connection_state == "ready" then
        poll_ready()
    end
end

local CP1251_TO_UNICODE = {
    [0xA8] = 0x0401, -- Ё
    [0xB8] = 0x0451, -- ё
    [0xB2] = 0x0406, -- І (Ukrainian, just in case)
    [0xB3] = 0x0456, -- і
    [0xBA] = 0x0458, -- ј
    [0xAA] = 0x0404, -- Є
    [0xBD] = 0x0455, -- ѕ
}

local function cp1251_to_utf8(s)
    if not s then return s end
    local out = {}
    for i = 1, #s do
        local b = s:byte(i)
        local cp

        if b < 0x80 then
            cp = b
        elseif CP1251_TO_UNICODE[b] then
            cp = CP1251_TO_UNICODE[b]
        elseif b >= 0xC0 then
            cp = b - 0xC0 + 0x0410
        else
            cp = b
        end

        if cp < 0x80 then
            table.insert(out, string.char(cp))
        elseif cp < 0x800 then
            table.insert(out, string.char(
                0xC0 + math.floor(cp / 0x40),
                0x80 + (cp % 0x40)
            ))
        else
            table.insert(out, string.char(
                0xE0 + math.floor(cp / 0x1000),
                0x80 + (math.floor(cp / 0x40) % 0x40),
                0x80 + (cp % 0x40)
            ))
        end
    end
    return table.concat(out)
end

local function get_squad_size()
    return safe_call("squad_size", 1, function()
        local count = 1 -- Start with 1 for the Actor
        
        if axr_companions and axr_companions.companion_squads then
            for squad_id, _ in pairs(axr_companions.companion_squads) do
                local squad = alife_object(squad_id)
                if squad then
                    count = count + squad:npc_count()
                end
            end
        end
        return count
    end)
end

local function get_active_task_title()
    return safe_call("active_task_title", "", function()
        if not db.actor then return "" end

        local tm = task_manager.get_task_manager()
        if not tm or not tm.task_info then return "" end

        for _, tsk in pairs(tm.task_info) do
            local t = tsk.t or db.actor:get_task(tsk.id, true)
            if t and db.actor:is_active_task(t) then
                local raw_title = tsk.current_title or tsk.title
                if raw_title and raw_title ~= "" then
                    return cp1251_to_utf8(game.translate_string(raw_title))
                end
                return ""
            end
        end

        return "" -- nothing is currently tracked/selected
    end)
end

local function is_empty(s)
    return s == nil or s == ""
end

local function process_template(template_str, variables)
    if not template_str then return "" end
    local result = template_str
    for placeholder, value in pairs(variables) do
        result = result:gsub("{" .. placeholder .. "}", tostring(value))
    end
    return result
end

-- ==============================================================================
-- Presence Template Loading
-- ==============================================================================

local TEMPLATE_KEYS = {
    "details", "state",
    "large_image_key", "large_image_text",
    "small_image_key", "small_image_text",
    "party_size", "party_max",
    "button_1_label", "button_1_url",
    "button_2_label", "button_2_url"
}

local function load_custom_templates()
    local ini = ini_file("rpc_config.ltx")
    local data = {}
    if not (ini and ini:section_exist("rpc_settings")) then
        return data
    end

    for _, key in ipairs(TEMPLATE_KEYS) do
        if ini:line_exist("rpc_settings", key) then
            local raw_val = ini:r_string("rpc_settings", key)
            if raw_val then
                raw_val = raw_val:gsub("^%s+", ""):gsub("%s+$", "")
                if raw_val:sub(1, 1) == "\"" and raw_val:sub(-1) == "\"" then
                    raw_val = raw_val:sub(2, -2)
                end
                data[key] = raw_val
            end
        end
    end
    return data
end

local function json_encode(value)
    local t = type(value)
    if t == "table" then
        local parts = {}
        if #value > 0 then
            for _, v in ipairs(value) do
                table.insert(parts, json_encode(v))
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        for k, v in pairs(value) do
            table.insert(parts, string.format("\"%s\":%s", tostring(k), json_encode(v)))
        end
        return "{" .. table.concat(parts, ",") .. "}"
    elseif t == "string" then
        return "\"" .. value:gsub("\\", "\\\\"):gsub("\"", "\\\"") .. "\""
    elseif t == "number" then
        return tostring(value)
    elseif t == "boolean" then
        return value and "true" or "false"
    end
    return "null"
end

local PLACEHOLDER_DUMP_ORDER = {
    "level", "level_raw", "faction", "faction_raw",
    "health", "money", "squad_size",
    "rank", "rank_raw", "reputation", "reputation_raw",
    "active_task",
    "mutants_killed", "stalkers_killed", "pdas_delivered", "boxes_smashed",
    "level_changes", "tasks_completed", "artifacts_detected", "enemy_forfeits",
    "helicopters_downed", "stashes_found", "wounded_helped", "field_dressings",
}

-- maps output variable name -> game_statistics key
local STAT_DEFS = {
    { "mutants_killed",      "killed_monsters" },
    { "stalkers_killed",     "killed_stalkers" },
    { "pdas_delivered",      "pdas_delivered" },
    { "boxes_smashed",       "boxes_smashed" },
    { "level_changes",       "level_changes" },
    { "tasks_completed",     "tasks_completed" },
    { "artifacts_detected",  "artifacts_detected" },
    { "enemy_forfeits",      "enemies_surrendered" },
    { "helicopters_downed",  "helicopters_downed" },
    { "stashes_found",       "stashes_found" },
    { "wounded_helped",      "wounded_helped" },
    { "field_dressings",     "field_dressings" },
}

local function get_stat(key)
    return safe_call("stat:" .. key, 0, game_statistics.get_statistic_count, key)
end

local function dump_placeholder_values(variables)
    if not last_known_debug_state then return end
    write_custom_log("[DEBUG]", "===== Placeholder values =====")
    for _, key in ipairs(PLACEHOLDER_DUMP_ORDER) do
        write_custom_log("[DEBUG]", string.format("%s: %s", key, tostring(variables[key])))
    end
    write_custom_log("[DEBUG]", "==============================")
end

local function build_variables()
    local raw_level = safe_call("level.name", "unknown", level.name)
    local raw_faction = safe_call("community", "stalker", character_community, db.actor):gsub("^actor_", "")

    local variables = {
        level = cp1251_to_utf8(safe_call("translate level", raw_level, game.translate_string, raw_level)),
        level_raw = string.lower(raw_level),
        faction = cp1251_to_utf8(safe_call("translate faction", raw_faction, game.translate_string, raw_faction)),
        faction_raw = string.lower(raw_faction),
        health = safe_call("health", 100, function() return math.floor(db.actor.health * 100) end),
        money = safe_call("money", 0, db.actor.money, db.actor),
        squad_size = get_squad_size(),
    }

    for _, def in ipairs(STAT_DEFS) do
        variables[def[1]] = get_stat(def[2])
    end
    variables.rank = cp1251_to_utf8(safe_call("translate rank", "novice", game.translate_string, ranks.get_obj_rank_name(db.actor)))
    variables.rank_raw = safe_call("rank_raw", 0, function() return db.actor:character_rank() end)
    variables.reputation = cp1251_to_utf8(safe_call("translate reputation", "neutral", game.translate_string, utils_obj.get_reputation_name(db.actor:character_reputation())))
    variables.reputation_raw = safe_call("rept_raw", 0, function() return db.actor:character_reputation() end)
    variables.active_task = get_active_task_title()

    return variables
end

local function build_buttons(tmpl)
    local buttons = {}
    if tmpl.button_1_label and tmpl.button_1_url then
        table.insert(buttons, { label = tmpl.button_1_label, url = tmpl.button_1_url })
    end
    if tmpl.button_2_label and tmpl.button_2_url then
        table.insert(buttons, { label = tmpl.button_2_label, url = tmpl.button_2_url })
    end
    return buttons
end

-- ==============================================================================
-- Presence Payload Construction
-- ==============================================================================

local function build_discord_payload(tmpl, variables)
    local discord_payload = {
        timestamps = { start = _G.anomaly_rpc_start_time },
    }

    if not is_empty(tmpl.details) then
        discord_payload.details = process_template(tmpl.details, variables)
    end
    if not is_empty(tmpl.state) then
        discord_payload.state = process_template(tmpl.state, variables)
    end

    local assets = {}
    if not is_empty(tmpl.large_image_key) then
        assets.large_image = process_template(tmpl.large_image_key, variables)
    end
    if not is_empty(tmpl.large_image_text) then
        assets.large_text = process_template(tmpl.large_image_text, variables)
    end
    if not is_empty(tmpl.small_image_key) then
        assets.small_image = process_template(tmpl.small_image_key, variables)
    end
    if not is_empty(tmpl.small_image_text) then
        assets.small_text = process_template(tmpl.small_image_text, variables)
    end
    if next(assets) ~= nil then
        discord_payload.assets = assets
    end

    local p_size = tonumber(process_template(tmpl.party_size, variables))
    local p_max = tonumber(process_template(tmpl.party_max, variables))
    if p_size ~= nil then
        discord_payload.party = { size = p_max ~= nil and { p_size, p_max } or { p_size } }
    end

    local buttons = build_buttons(tmpl)
    if #buttons > 0 then discord_payload.buttons = buttons end

    return discord_payload
end

-- rebuilds game state and queues it for delivery; the network state machine
-- (see network_tick above) is what actually sends it, rate-limited
local function update_presence(dump_placeholders)
    local tmpl = load_custom_templates()
    local variables = build_variables()

    if dump_placeholders then dump_placeholder_values(variables) end

    local encoded = json_encode(build_discord_payload(tmpl, variables))

    if encoded == last_sent_payload or encoded == pending_payload then
        return
    end

    pending_payload = encoded
    dbg("Presence payload changed, queued for delivery.")
end

-- ==============================================================================
-- Update Loop / Callback Wiring
-- ==============================================================================

function actor_on_update()
    if not db.actor then return end

    safe_call("network_tick", nil, network_tick)

    local tg = time_global()
    if tg > last_update_time + POLL_INTERVAL_MS then
        last_update_time = tg
        refresh_debug_state()
        safe_call("update_presence", nil, update_presence)
    end
end

function on_game_start()
    refresh_debug_state()
    dbg("Anomaly RPC starting up.")
    RegisterScriptCallback("on_option_change", function(...) refresh_debug_state() end)
    RegisterScriptCallback("actor_on_first_update", function()
        refresh_debug_state()
        local should_dump = not has_dumped_placeholders
        has_dumped_placeholders = true
        safe_call("update_presence", nil, update_presence, should_dump)
    end)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_level_changing", function()
        safe_call("update_presence", nil, update_presence)
    end)
end